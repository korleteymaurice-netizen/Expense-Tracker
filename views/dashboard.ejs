<%- include('partials_header') %><div class="d-flex flex-wrap justify-content-between align-items-center mb-4"><div><p class="eyebrow mb-1">OVERVIEW</p><h1 class="h3 fw-bold mb-1">Financial dashboard</h1><p class="text-secondary mb-0">A simple view of your money.</p></div><a href="/transactions/new" class="btn btn-primary"><span class="me-1">+</span> Add transaction</a></div><div class="row g-3 mb-4"><div class="col-md-4"><div class="stat-card"><div class="stat-label">Total balance</div><div class="stat-value"><%= money(balance) %></div><div class="small text-secondary">Income minus expenses</div></div></div><div class="col-md-4"><div class="stat-card"><div class="stat-label">Total income</div><div class="stat-value text-success"><%= money(summary.income) %></div><div class="small text-secondary">All recorded income</div></div></div><div class="col-md-4"><div class="stat-card"><div class="stat-label">Total expenses</div><div class="stat-value text-danger"><%= money(summary.expenses) %></div><div class="small text-secondary">All recorded expenses</div></div></div></div><div class="row g-4 mb-4"><div class="col-lg-8"><div class="card dashboard-card h-100"><div class="card-body"><div class="d-flex justify-content-between"><div><h2 class="h6 fw-bold">Income vs expenses</h2><p class="small text-secondary">Last six months</p></div></div><div class="chart-box"><canvas id="monthlyChart"></canvas></div></div></div></div><div class="col-lg-4"><div class="card dashboard-card h-100"><div class="card-body"><h2 class="h6 fw-bold">Top spending categories</h2><p class="small text-secondary">Where your expenses go</p><div class="chart-box"><canvas id="categoryChart"></canvas></div></div></div></div></div><div class="card dashboard-card"><div class="card-body"><div class="d-flex justify-content-between align-items-center mb-3"><div><h2 class="h6 fw-bold mb-1">Recent transactions</h2><p class="small text-secondary mb-0">Your latest financial activity</p></div><a href="/transactions" class="small">View all</a></div><%- include('transaction_table', {transactions: recent, compact:true}) %></div></div><script>window.dashboardData=<%- JSON.stringify({monthly,categories}) %></script><%- include('partials_footer') %>
