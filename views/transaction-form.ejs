<%- include('partials_header') %><div class="row justify-content-center"><div class="col-lg-7"><a href="/transactions" class="small text-decoration-none">← Back to transactions</a><div class="card dashboard-card mt-3"><div class="card-body p-4"><h1 class="h4 fw-bold"><%= transaction ? 'Edit transaction' : 'Add transaction' %></h1><p class="text-secondary mb-4">Record an income or expense.</p><% if(typeof error!=='undefined' && error){ %><div class="alert alert-danger"><%= error %></div><% } %><form method="post" action="<%= transaction ? '/transactions/'+transaction.id+'/update' : '/transactions' %>"><div class="mb-3"><label class="form-label">Transaction type</label><div class="d-flex gap-2"><input class="btn-check" type="radio" name="type" value="income" id="income" <%= !transaction || transaction.type==='income'?'checked':'' %>><label class="btn btn-outline-success flex-fill" for="income">Income</label><input class="btn-check" type="radio" name="type" value="expense" id="expense" <%= transaction && transaction.type==='expense'?'checked':'' %>><label class="btn btn-outline-danger flex-fill" for="expense">Expense</label></div></div><div class="row g-3"><div class="col-md-6"><label class="form-label">Amount (GHS)</label><input class="form-control" type="number" name="amount" min="0.01" step="0.01" value="<%= transaction?.amount || '' %>" required></div><div class="col-md-6"><label class="form-label">Category</label><select class="form-select" name="category" required><option value="">Choose category</option><% categories.forEach(c=>{ %><option <%= transaction?.category===c?'selected':'' %>><%= c %></option><% }) %></select></div><div class="col-12"><label class="form-label">Description</label><input class="form-control" name="description" maxlength="255" value="<%= transaction?.description || '' %>" placeholder="e.g. September salary"></div><div class="col-12"><label class="form-label">Date</label><input class="form-control" type="date" name="transaction_date" value="<%= transaction?.transaction_date ? String(transaction.transaction_date).slice(0,10) : new Date().toISOString().slice(0,10) %>" required></div></div><button class="btn btn-primary w-100 mt-4"><%= transaction ? 'Save changes' : 'Add transaction' %></button></form></div></div></div></div><%- include('partials_footer') %>
