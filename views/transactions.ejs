<%- include('partials_header') %><div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4"><div><p class="eyebrow mb-1">ACTIVITY</p><h1 class="h3 fw-bold mb-1">Transactions</h1><p class="text-secondary mb-0">Manage your income and expenses.</p></div><a href="/transactions/new" class="btn btn-primary">+ Add transaction</a></div><div class="card dashboard-card mb-4"><div class="card-body"><form class="row g-2" method="get"><div class="col-md-4"><input class="form-control" name="search" value="<%= search %>" placeholder="Search description or category"></div><div class="col-md-3"><select class="form-select" name="type"><option value="">All types</option><option value="income" <%= type==='income'?'selected':'' %>>Income</option><option value="expense" <%= type==='expense'?'selected':'' %>>Expense</option></select></div><div class="col-md-3"><select class="form-select" name="category"><option value="">All categories</option><% categories.forEach(c=>{ %><option <%= category===c?'selected':'' %>><%= c %></option><% }) %></select></div><div class="col-md-2 d-grid"><button class="btn btn-outline-primary">Filter</button></div></form></div></div><div class="card dashboard-card"><div class="card-body p-0"><%- include('transaction_table', {transactions, compact:false}) %></div></div><%- include('partials_footer') %>
