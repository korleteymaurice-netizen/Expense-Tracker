<div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Date</th><th>Transaction</th><th>Category</th><th>Type</th><th class="text-end">Amount</th><th></th></tr></thead><tbody><% if(!transactions.length){ %><tr><td colspan="6" class="text-center py-5 text-secondary">No transactions yet.</td></tr><% } %><% transactions.forEach(t=>{ %><tr><td class="text-secondary"><%= dateDisplay(t.transaction_date) %></td><td><div class="fw-semibold"><%= t.description || t.category %></div></td><td><span class="badge category-badge"><%= t.category %></span></td><td><span class="badge rounded-pill <%= t.type==='income'?'income-badge':'expense-badge' %>"><%= t.type %></span></td><td class="text-end fw-semibold <%= t.type==='income'?'text-success':'text-danger' %>"><%= t.type==='income'?'+':'-' %><%= money(t.amount) %></td><td class="text-end"><% if(!compact){ %><a class="btn btn-sm btn-light" href="/transactions/<%= t.id %>/edit">Edit</a> <form class="d-inline" method="post" action="/transactions/<%= t.id %>/delete" onsubmit="return confirm('Delete this transaction?')"><button class="btn btn-sm btn-light text-danger">Delete</button></form><% } %></td></tr><% }) %></tbody></table></div>
